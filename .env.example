# EL-KALEL production secrets
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-before-first-production-login

# Browser/API
CORS_ORIGINS=https://YOUR_PUBLIC_HOST
PUBLIC_HOST=YOUR_PUBLIC_HOST

# SMS gateway
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER=EL-KALEL

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=generate-a-random-webhook-token
WHATSAPP_GRAPH_VERSION=v23.0

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=EL-KALEL ENTERPRISE <no-reply@your-company-email.com>
SMTP_USE_SSL=false

# Optional email reply-to address
SMTP_REPLY_TO=
